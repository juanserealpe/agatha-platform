# Copia este archivo como .env (o .env.local) y ajusta los valores.

# URL del backend en producción. En desarrollo no se usa: Vite hace proxy de /api (ver vite.config.ts).
VITE_API_BASE_URL=https://129.213.118.230

# Demo en /demo con datos simulados, sin backend. Encendida si no se define; "false" la apaga y /demo
# redirige a la app real.
VITE_ENABLE_DEMO=true

# Evidencias fotográficas de una alerta: apagadas hasta que exista el endpoint.
VITE_FEATURE_ALERT_EVIDENCE=false

# Solo en tu PC (mejor en .env.development.local): /api/notifications va a un backend local, p. ej.
# http://localhost:8080; el resto de /api sigue yendo al VPS. Vacía = todo al VPS.
LOCAL_NOTIFICATIONS_URL=
