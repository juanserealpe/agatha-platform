# Plantilla del .env del backend. Copiar a .env y completar.
# Sin secretos reales: el .env nunca se sube al repositorio.
#
# Los valores de este archivo son SEGUROS POR DEFECTO: con ellos no se envían
# push reales y el endpoint de eventos de prueba está apagado.

# --- Plataforma ----------------------------------------------------------------

# Base de datos PostgreSQL. OJO: la del piloto es PRODUCCIÓN y la comparte el VPS.
DATABASE_URL=postgres://usuario:clave@host:5432/agatha?sslmode=require

# Entorno: "production" en el VPS. Con production se rechazan -rebuild y el
# endpoint de eventos de prueba.
AGATHA_ENV=development

# Módulos a levantar, separados por coma (vacía = baseline,callback,dashboard).
#   VPS:   callback,dashboard,baseline,processing,rule_engine,alert_management,notifications
#   Local contra la base del piloto: SOLO notifications (y dashboard si hace falta).
#   baseline, processing, rule_engine, alert_management, dataos y callback corren
#   schedulers o migraciones que escriben en la base que ya procesa el VPS.
AGATHA_MODULES=notifications

# Orígenes que el navegador puede usar (separados por coma, sin "*").
AGATHA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Token Bearer del callback de Dataflow Labs (módulo callback).
AGATHA_CALLBACK_TOKEN=

# Credenciales de DataOS (solo el módulo dataos).
DATAOS_USERNAME=
DATAOS_PASSWORD=

# --- Notifications: canal web (SSE) --------------------------------------------

# Tope de streams abiertos a la vez.
NOTIFICATIONS_SSE_MAX_CLIENTS=200

# --- Notifications: push FCM ---------------------------------------------------

# Proyecto Firebase de la app Android.
FCM_PROJECT_ID=agatha-5fe71

# Credencial de la cuenta de servicio. Sin ninguna, el push queda deshabilitado
# (el canal web sigue funcionando). El archivo tiene prioridad sobre el base64.
# En Docker se monta en solo lectura. Nunca pegar el contenido del JSON aquí si
# el archivo se va a compartir.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# true = FCM valida los mensajes sin entregarlos. Si no se define, también es
# true: los push reales hay que pedirlos con false (lo hace el docker-compose del VPS).
FCM_VALIDATE_ONLY=true

# Solo se envía a estos deviceId (CEL-XXXXXX, separados por coma). Vacía = a
# todos los celulares registrados. En local, poner aquí el celular de prueba.
NOTIFICATIONS_PUSH_DEVICE_ALLOWLIST=

# --- Notifications: desarrollo -------------------------------------------------

# Habilita POST /api/notifications/test-event (solo si AGATHA_ENV no es
# production). NUNCA en el VPS: los eventos llegan a los navegadores y celulares reales.
NOTIFICATIONS_TEST_ENDPOINT=false

# --- Ajustes opcionales ----------------------------------------------------------
# Tienen valores por defecto en el código; solo definirlos para cambiarlos.
# Detalle en el README de cada módulo y en internal/bootstrap.
#   ALERT_MANAGEMENT_CATCHUP_MINUTE, ALERT_MANAGEMENT_BACKFILL_BATCH_SIZE
#   BASELINE_HISTORY_DAYS, BASELINE_MIN_SIGNAL_RECORDS, BASELINE_MIN_COMPONENT_WINDOWS,
#   BASELINE_MAX_PASSES, BASELINE_EXCLUSION_I_CUTOFF, BASELINE_RECALC_INTERVAL,
#   BASELINE_LOW_RECALC_INTERVAL, BASELINE_KNOWN_EVENT_MARGIN,
#   BASELINE_METRIC_B1, BASELINE_METRIC_B2, BASELINE_METRIC_PLANITUD
#   PROCESSING_INITIAL_LOOKBACK_HOURS, PROCESSING_MAX_SLOTS_RECONCILER, PROCESSING_GRACE,
#   PROCESSING_METRIC_B1, PROCESSING_METRIC_B2, PROCESSING_METRIC_PLANITUD
